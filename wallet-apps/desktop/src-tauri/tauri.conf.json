{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRID Wallet",
  "version": "0.1.0",
  "identifier": "com.grid.wallet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GRID Wallet",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Manage GRID, Solana rewards, and the Bitcoin consolidation layer.",
    "longDescription": "Official GRID wallet using the encrypted GRID vault and local blockchain.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
