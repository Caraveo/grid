[Unit]
Description=GRID signed settlement block producer
After=network-online.target grid-genesis-truth.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/grid/producer.env
ExecStart=/opt/grid/bin/grid --config-dir /var/lib/grid genesis produce --operational --coordinator https://coordinator.grid-compute.com --poll-secs 5 --batch 25
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/grid

[Install]
WantedBy=multi-user.target
