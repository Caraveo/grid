{
  "name": "@grid/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GRID useful mining CLI — run nodes with `grid node`",
  "bin": {
    "grid": "./bin/grid"
  },
  "scripts": {
    "grid": "tsx src/main.ts",
    "node": "tsx src/main.ts node",
    "submit": "tsx src/main.ts submit",
    "stats": "tsx src/main.ts stats",
    "link-global": "npm link",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
